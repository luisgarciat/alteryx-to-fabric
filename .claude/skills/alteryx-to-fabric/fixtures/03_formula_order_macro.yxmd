    <Node ToolID="41">
      <GuiSettings Plugin="AlteryxGuiToolkit.Macro.Macro">
        <Position x="160" y="300" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Value name="Umbral">100</Value>
        </Configuration>
      </Properties>
      <EngineSettings Macro="Macros\limpieza_basica.yxmc" />
    </Node>
    <Node ToolID="42">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileOutput.DbFileOutput">
        <Position x="260" y="300" />
