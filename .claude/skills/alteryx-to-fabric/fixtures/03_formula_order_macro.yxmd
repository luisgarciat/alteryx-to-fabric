<?xml version="1.0"?>
<AlteryxDocument yxmdVer="2023.1">
  <Nodes>
    <!-- Cadena 1: Formula -> Sort -> Multi-Row Formula (con Sort explicito: NO debe generar WARN_ORDER_UNDEFINED) -->
    <Node ToolID="20">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="54" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <File>Files\contactos.csv</File>
        </Configuration>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>
    <Node ToolID="21">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="160" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="REGEX_Replace([email], &quot;@.*$&quot;, &quot;&quot;)" field="email_local" size="254" type="V_String" />
            <FormulaField expression="DateTimeParse([fecha_str], &quot;%m-%d-%Y&quot;)" field="fecha_dt" size="8" type="Date" />
          </FormulaFields>
        </Configuration>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>
    <Node ToolID="22">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Sort.Sort">
        <Position x="260" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <SortInfo>
            <Field field="fecha_dt" order="Ascending" />
          </SortInfo>
        </Configuration>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxSort" />
    </Node>
    <Node ToolID="23">
      <GuiSettings Plugin="AlteryxBasePluginsGui.MultiRowFormula.MultiRowFormula">
        <Position x="360" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Expression>IF [Row-1:fecha_dt]=[fecha_dt] THEN "mismo_dia" ELSE "nuevo_dia" ENDIF</Expression>
          <UpdateFieldName>marca_dia</UpdateFieldName>
          <GroupByFields>
            <Field field="email_local" />
          </GroupByFields>
        </Configuration>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxMultiRowFormula" />
    </Node>
    <Node ToolID="24">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileOutput.DbFileOutput">
        <Position x="460" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <File>Tables\lakehouse\output_regex_fecha.delta</File>
        </Configuration>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileOutput" />
    </Node>

    <!-- Cadena 2: Multi-Row Formula SIN Sort aguas arriba: SI debe generar WARN_ORDER_UNDEFINED -->
    <Node ToolID="30">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="54" y="200" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <File>Files\operaciones.csv</File>
        </Configuration>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>
    <Node ToolID="31">
      <GuiSettings Plugin="AlteryxBasePluginsGui.MultiRowFormula.MultiRowFormula">
        <Position x="160" y="200" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Expression>[Row-1:monto]+[monto]</Expression>
          <UpdateFieldName>acumulado</UpdateFieldName>
          <GroupByFields />
        </Configuration>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxMultiRowFormula" />
    </Node>
    <Node ToolID="32">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileOutput.DbFileOutput">
        <Position x="260" y="200" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <File>Tables\lakehouse\output_operaciones.delta</File>
        </Configuration>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileOutput" />
    </Node>

    <!-- Cadena 3: referencia a Macro custom -->
    <Node ToolID="40">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
